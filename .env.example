# Скопируйте в .env.local и заполните. Реальные значения staging/production — только в Vercel.
# Секретов в этом файле быть не должно.

# local | staging | production
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Локально: значения из `npm run db:start` (или `npx supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ТОЛЬКО СЕРВЕР (приглашения участников). Никогда не добавлять префикс NEXT_PUBLIC_.
# Локально: SECRET_KEY из `npx supabase status -o env`. В Vercel — как Sensitive.
SUPABASE_SECRET_KEY=
